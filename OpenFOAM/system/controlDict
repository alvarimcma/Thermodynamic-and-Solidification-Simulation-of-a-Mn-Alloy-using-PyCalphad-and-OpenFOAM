FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     chtMultiRegionFoam;

startFrom       latestTime;
startTime       0;
stopAt          endTime;
endTime         45;
deltaT          0.00001;

writeControl    adjustableRunTime;
writeInterval   0.075;

purgeWrite      0;

writeFormat     binary;
writePrecision  5;
writeCompression on;

timeFormat      general;
timePrecision   5;

runTimeModifiable yes;

adjustTimeStep  yes;
maxCo           5;
maxDi           10;
maxDeltaT       10;




