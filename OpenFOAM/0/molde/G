FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0/molde";
    object      G;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 0 -3 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    liqmetal_to_molde
    {
        type            MarshakRadiation;
        emissivityMode  lookup;
        emissivity      uniform 0.8;
        value           $internalField;
    }

    ".*"
    {
        type            MarshakRadiation;
        emissivityMode  lookup;
        emissivity      uniform 0.8;
        value           $internalField;
    }
}


