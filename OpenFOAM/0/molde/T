FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0/molde";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 300;

boundaryField
{
    ".*"
    {
        type            externalWallHeatFluxTemperature;
        mode            coefficient;
        Ta              uniform 300;        //TEMPERATURA AMBIENTE
        h               uniform 10;         //COEF TRANSF CALOR AR W/m^2/K
        kappaMethod     solidThermo;        //USA CONDUTIVIDADE LA NO MOLDE PROPERTIES
        value           uniform 300;
    }
    molde_to_liqmetal
    {
        type            compressible::turbulentTemperatureRadCoupledMixed;
        Tnbr            T;
        kappaMethod     solidThermo;
        value           uniform 500;
    }
}


