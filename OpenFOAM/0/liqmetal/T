FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0/liqmetal";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 1770;

boundaryField
{
    liqmetal_to_molde
    {
        type            compressible::turbulentTemperatureRadCoupledMixed;
        Tnbr            T;
        kappaMethod     fluidThermo;
        value           uniform 1770;
    }
    atmosphere
    {
        type            externalWallHeatFluxTemperature;
        mode            coefficient;
    
        h               uniform 120;     //COEF TRANSF CALOR (120 PARA INCLUIR RADIACAO)
        Ta              uniform 300;    //AMB TEMP (K)

        //qr              qr;             //RADIATION
        //emissivity      0.4;            //EMISSIVIDADE DA SUPERFICIE PARA O CAMPO RADIOATIVO

        kappaMethod     fluidThermo;
        value           $internalField; 
    }
}


